# EduGenie Configuration Example
# Copy this file to .env and set your Gemini API key.

# Gemini API Key (Get one at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name
# Supported models: gemini-2.5-flash, gemini-3.7-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Local LaMini-Flan-T5 Model (Optional)
# Set to true to attempt loading local transformers model for explanations.
# If dependencies or model weights are missing, it will automatically fall back to Gemini.
ENABLE_LOCAL_MODEL=false
LOCAL_MODEL_NAME=MBZUAI/LaMini-Flan-T5-248M

# Server Configuration
HOST=127.0.0.1
PORT=8000
